{
  "name": "vastrivo",
  "private": true,
  "version": "0.1.0",
  "description": "Development launcher for the Vastrivo React and FastAPI marketplace.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/dev.mjs --setup-only",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs current",
    "deploy:gcp": "node scripts/deploy-gcp.mjs",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:check": "npm --prefix mobile run check"
  }
}
