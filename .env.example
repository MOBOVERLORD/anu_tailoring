# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tailor_db
# In Cloud Run, set DATABASE_URL from Secret Manager. It overrides the
# individual PostgreSQL values and can point at a Cloud SQL Unix socket.
# DATABASE_URL=postgresql+asyncpg://user:encoded-password@/tailor_db?host=/cloudsql/project:region:instance

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional
ENVIRONMENT=development
SERVE_FRONTEND=false
