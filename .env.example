# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tailor_db
# In Cloud Run, set DATABASE_URL from Secret Manager. It overrides the
# individual PostgreSQL values and can point at a Cloud SQL Unix socket.
# DATABASE_URL=postgresql+asyncpg://user:encoded-password@/tailor_db?host=/cloudsql/project:region:instance

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_MINUTES=30
MAX_ACTIVE_SESSIONS_PER_USER=5
JWT_ISSUER=vastrivo-api
JWT_AUDIENCE=vastrivo-ui
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Design images (required for vendor uploads)
# Keep the bucket private. Only FastAPI communicates with Cloud Storage.
GCS_BUCKET_NAME=your-private-design-bucket
# Optional for local ADC impersonation; Cloud Run uses its attached identity.
GCS_SIGNING_SERVICE_ACCOUNT=your-runtime-service-account@your-project-id.iam.gserviceaccount.com
MAX_DESIGN_IMAGE_MB=2
MAX_INVOICE_ATTACHMENT_MB=5
VENDOR_CONTACT_EMAIL=vendors@vastrivo.com
BUSINESS_LEGAL_NAME=Your registered business name
BUSINESS_ADDRESS=Your public business correspondence address
SUPPORT_PHONE=

# Transactional email
# Local development can use `console` to print email contents in backend logs.
# Cloud Run should use `resend`, with RESEND_API_KEY mapped from Secret Manager.
APP_NAME=Vastrivo
PUBLIC_APP_URL=http://localhost:5173
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Vastrivo
EMAIL_NOTIFICATIONS_ENABLED=true
PASSWORD_RESET_EXPIRE_MINUTES=20
# RESEND_API_KEY=do-not-store-provider-keys-in-this-file

# Delivery distance (backend only)
# OpenStreetMap is the default for local development. Public Nominatim/OSRM
# endpoints are rate-limited and intentionally blocked in production unless
# explicitly acknowledged. Prefer managed or self-hosted compatible endpoints.
MAPS_PROVIDER=openstreetmap
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_ROUTING_URL=https://router.project-osrm.org
OSM_ALLOW_PUBLIC_SERVICES_IN_PRODUCTION=false
OSM_MIN_REQUEST_INTERVAL_SECONDS=1.05
# Optional Google fallback. Keep the restricted key in ignored .env locally
# and Secret Manager in Cloud Run, then set MAPS_PROVIDER=google.
GOOGLE_MAPS_API_KEY=

# Razorpay Standard Web Checkout (backend only)
# Generate separate Test and Live keys. Keep both values in Secret Manager in
# Cloud Run; the backend returns only the Key ID to authenticated checkout UI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a different high-entropy value configured on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_HTTP_TIMEOUT_SECONDS=10

# Optional
ENVIRONMENT=development
SERVE_FRONTEND=false
